html\'] = xhtml(title, \'<h1>\' + esc(title) + \'</h1>\' + \'\'.join(\'<p>\' + esc(p) + \'</p>\' for p in paragraphs))\nmanifest = \'<item id="nav" href="nav.xhtml" media-type="application/xhtml+xml" properties="nav"/><item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/><item id="css" href="style.css" media-type="text/css"/>\'\nmanifest += \'\'.join(f\'<item id="ch{i}" href="chapter{i}.xhtml" media-type="application/xhtml+xml"/>\' for i in range(1, len(chapters)+1))\nspine = \'<itemref idref="nav"/>\' + \'\'.join(f\'<itemref idref="ch{i}"/>\' for i in range(1,len(chapters)+1))\nentries[\'OEBPS/content.opf\'] = f\'\'\'<?xml version="1.0" encoding="utf-8"?><package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="book-id" xml:lang="en"><metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:identifier id="book-id">{uid}</dc:identifier><dc:title>Pass Through</dc:title><dc:language>en</dc:language><meta property="dcterms:modified">{modified}</meta></metadata><manifest>{manifest}</manifest><spine toc="ncx">{spine}</spine></package>\'\'\'\npoints = \'\'.join(f\'<navPoint id="ch{i}" playOrder="{i}"><navLabel><text>{esc(title)}</text></navLabel><content src="chapter{i}.xhtml"/></navPoint>\' for i,(title,_) in enumerate(chapters,1))\nentries[\'OEBPS/toc.ncx\'] = f\'<?xml version="1.0" encoding="utf-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1"><head><meta name="dtb:uid" content="{uid}"/><meta name="dtb:depth" content="1"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>Pass Through</text></docTitle><navMap>{points}</navMap></ncx>\'\nout = root / \'Pass Through.epub\'\nwith zipfile.ZipFile(out, \'w\', compression=zipfile.ZIP_DEFLATED) as z:\n    z.writestr(\'mimetype\', \'application/epub+zip\', compress_type=zipfile.ZIP_STORED)\n    for name, data in entries.items():\n        z.writestr(name, data.encode(\'utf-8\'))\nwith zipfile.ZipFile(out) as z:\