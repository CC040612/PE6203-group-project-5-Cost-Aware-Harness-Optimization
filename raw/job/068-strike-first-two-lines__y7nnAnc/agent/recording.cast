[32.392987, "i", "python - <<'PY'\nfrom zipfile import ZipFile\nfrom lxml import etree\nimport os\npath='/app/New_Club_Spring_2018_Training.pptx'\nns={'a':'http://schemas.openxmlformats.org/drawingml/2006/main','p':'http://schemas.openxmlformats.org/presentationml/2006/main'}\na='{'+ns['a']+'}'\nwith ZipFile(path) as src:\n root=etree.fromstring(src.read('ppt/slides/slide7.xml'))\n targets=[]\n for sp in root.findall('.//p:sp',ns):\n  paras=sp.findall('./p:txBody/a:p',ns)\n  if paras and ''.join(paras[0].xpath('.//a:t/text()',namespaces=ns)).startswith('Request campus space'):\n   targets=paras[:2]\n assert len(targets)==2\n for p in targets:\n  pp=p.find(a+'pPr')\n  if pp is None:\n   pp=etree.Element(a+'pPr'); p.insert(0,pp)\n  default=pp.find(a+'defRPr')\n  if default is None:\n   default=etree.SubElement(pp,a+'defRPr')\n  default.set('strike','sngStrike')\n  for run in p.findall(a+'r')+p.findall(a+'fld'):\n   rp=run.find(a+'rPr')\n   if rp is None:\n    rp=etree.Element(a+'rPr'); run.insert(0,rp)\n   rp.set('strike','sngStrike')\n  end=p.find(a+'endParaRPr')\n  if end is not None: end.set('strike','sngStrike')\n  print('Struck through:', ''.join(p.xpath('.//a:t/text()',namespaces=ns)))\n data=etree.tostring(root,xml_declaration=True,encoding='UTF-8',standalone=True)\n with ZipFile(path+'.tmp','w') as dst:\n  for item in src.infolist():\n   dst.writestr(item,data if item.filename=='ppt/slides/slide7.xml' else src.read(item.filename))\nos.replace(path+'.tmp',path)\nwith ZipFile(path) as z:\n assert z.testzip() is None\n root=etree.fromstring(z.read('ppt/slides/slide7.xml'))\n assert len(root.xpath('//a:rPr[@strike=\"sngStrike\"]',namespaces=ns))>=2\nprint('Saved and verified:',path)\nPY\n"]
