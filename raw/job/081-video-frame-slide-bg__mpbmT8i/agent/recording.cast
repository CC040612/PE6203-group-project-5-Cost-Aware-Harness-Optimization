[30.186958, "i", "python - <<'PY'\nfrom lxml import etree as E\nimport zipfile, os\np='/app/Robotic_Workshop_Infographics.pptx'\nns={'p':'http://schemas.openxmlformats.org/presentationml/2006/main','a':'http://schemas.openxmlformats.org/drawingml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships'}\nrel='http://schemas.openxmlformats.org/package/2006/relationships'\nct='http://schemas.openxmlformats.org/package/2006/content-types'\nwith zipfile.ZipFile(p) as z:\n root=E.fromstring(z.read('ppt/slides/slide2.xml'))\n relationships=E.fromstring(z.read('ppt/slides/_rels/slide2.xml.rels'))\n rid='rIdBackground8s'\n assert not any(x.get('Id')==rid for x in relationships)\n media='ppt/media/landscape_frame_8s.png'\n assert media not in z.namelist()\n E.SubElement(relationships,'{'+rel+'}Relationship',Id=rid,Type=ns['r']+'/image',Target='../media/landscape_frame_8s.png')\n cs=root.find('p:cSld',ns)\n old=cs.find('p:bg',ns)\n if old is not None: cs.remove(old)\n bg=E.Element('{'+ns['p']+'}bg')\n pr=E.SubElement(bg,'{'+ns["]
[30.187279, "i", "'p']+'}bgPr')\n fill=E.SubElement(pr,'{'+ns['a']+'}blipFill',dpi='0',rotWithShape='1')\n E.SubElement(fill,'{'+ns['a']+'}blip',{'{'+ns['r']+'}embed':rid})\n stretch=E.SubElement(fill,'{'+ns['a']+'}stretch')\n E.SubElement(stretch,'{'+ns['a']+'}fillRect')\n E.SubElement(pr,'{'+ns['a']+'}effectLst')\n cs.insert(0,bg)\n types=E.fromstring(z.read('[Content_Types].xml'))\n if not any(x.get('Extension','').lower()=='png' for x in types):\n  E.SubElement(types,'{'+ct+'}Default',Extension='png',ContentType='image/png')\n def serial(x): return E.tostring(x,xml_declaration=True,encoding='UTF-8',standalone=True)\n changes={'ppt/slides/slide2.xml':serial(root),'ppt/slides/_rels/slide2.xml.rels':serial(relationships),'[Content_Types].xml':serial(types)}\n with zipfile.ZipFile(p+'.tmp','w',zipfile.ZIP_DEFLATED) as out:\n  for item in z.infolist(): out.writestr(item,changes.get(item.filename,z.read(item.filename)))\n  out.write('/tmp/landscape_8s.png',media)\nwith zipfile.ZipFile(p+'.tmp') as z:\n assert z.testzip() is None\n r=E.fromstring"]
[30.187415, "i", "(z.read('ppt/slides/slide2.xml'))\n assert r.find('p:cSld/p:bg/p:bgPr/a:blipFill/a:blip',ns).get('{'+ns['r']+'}embed')==rid\nos.replace(p+'.tmp',p)\nos.remove('/tmp/landscape_8s.png')\nprint('Saved and verified:',p)\nPY\n"]
