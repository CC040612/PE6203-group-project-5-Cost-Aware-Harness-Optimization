[90.631948, "i", "/tmp/contactenv/bin/python - <<'PY'\nimport openpyxl\nfrom openpyxl.comments import Comment\np='/home/user/Desktop/Professor_Contact.xlsx'\nw=openpyxl.load_workbook(p)\ns=w['Sheet1']\nentries=[(3,'liuqi@cs.hku.hk','https://leuchine.github.io/'),(4,'tao.yu.nlp@gmail.com','https://taoyds.github.io/'),(5,'lpk@cs.hku.hk','https://ikekonglp.github.io/contact.html')]\nfor row,email,source in entries:\n s.cell(row,6,email)\n s.cell(row,6).comment=Comment('Source: '+source,'Source')\nw.save(p)\nv=openpyxl.load_workbook(p)\nfor row in v['Sheet1'].iter_rows(min_row=3,max_row=5):\n print(row[1].value, row[5].value)\nassert all(v['Sheet1'].cell(r,6).value==e for r,e,_ in entries)\nprint('Saved and verified:',p)\nPY\n"]
