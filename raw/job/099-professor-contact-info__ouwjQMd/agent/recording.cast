[53.796568, "i", "/tmp/contactenv/bin/python - <<'PY'\nimport requests,bs4,concurrent.futures\nurls=['https://leuchine.github.io/','https://taoyds.github.io/','https://ikekonglp.github.io/']\ndef fetch(u):\n try:\n  r=requests.get(u,timeout=30); s=bs4.BeautifulSoup(r.text,'html.parser')\n  print('\\nURL',u,'STATUS',r.status_code,'\\n',s.get_text(' ',strip=True)[:18000], '\\nMAILTO',[a.get('href') for a in s.select('a[href^=\"mailto:\"]')])\n  open('/tmp/'+u.split('/')[2]+'.html','w').write(r.text)\n except Exception as e: print(u,e)\nwith concurrent.futures.ThreadPoolExecutor() as ex: list(ex.map(fetch,urls))\nPY\n"]
