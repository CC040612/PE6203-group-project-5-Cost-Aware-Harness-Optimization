[?2004h[01;32magent@c88500295499[00m:[01;34m/app[00m$ cat > /tmp/convert_graphemes.py <<'PY'
[?2004l[?2004h> from zipfile import ZipFile
[?2004l[?2004h> from lxml import etree as E
[?2004l[?2004h> from copy import deepcopy
[?2004l[?2004h> import os
[?2004l[?2004h> path='/app/Graphemes_Sound_Letter_Patterns.docx'
[?2004l[?2004h> W='http://schemas.openxmlformats.org/wordprocessingml/2006/main'
[?2004l[?2004h> ns={'w':W}
[?2004l[?2004h> def tag(s): return '{'+W+'}'+s
[?2004l[?2004h> def el(s, **attrs):
[?2004l[?2004h>  e=E.Element(tag(s))
[?2004l[?2004h>  for k,v in attrs.items(): e.set(tag(k),str(v))
[?2004l[?2004h>  return e
[?2004l[?2004h> with ZipFile(path) as z:
[?2004l[?2004h>  infos=z.infolist(); data={i.filename:z.read(i.filename) for i in infos}
[?2004l[?2004h> root=E.fromstring(data['word/document.xml'])
[?2004l[?2004h> body=root.find('w:body',ns)
[?2004l[?2004h> original=list(body)
[?2004l[?2004h> selected=original[4:9]
[?2004l[?2004h> expected=[''.join(p.xpath('.//w:t/text()',namespaces=ns)).split(',') for p in selected]
[?2004l[?2004h> assert all(len(r)==4 for r in expected)
[?2004l[?2004h> sect=body.find('w:sectPr',ns)
[?2004l[?2004h> size=sect.find('w:pgSz',ns); mar=sect.find('w:pgMar',ns)
[?2004l[?2004h> width=int(size.get(tag('w')))-int(mar.get(tag('left')))-int(mar.get(tag('right')))
[?2004l[?2004h> widths=[int(width*f) for f in (.34,.18,.24)]
[?2004l[?2004h> widths.append(width-sum(widths))
[?2004l[?2004h> table=el('tbl'); props=el('tblPr'); table.append(props)
[?2004l[?2004h> props.append(el('tblW',w=width,type='dxa'))
[?2004l[?2004h> borders=el('tblBorders')
[?2004l[?2004h> for side in ['top','left','bottom','right','insideH','insideV']:
[?2004l[?2004h>  borders.append(el(side,val='single',sz=4,color='000000'))
[?2004l[?2004h> props.append(borders)
[?2004l[?2004h> props.append(el('tblLayout',type='fixed'))
[?2004l[?2004h> grid=el('tblGrid')
[?2004l[?2004h> for w in widths: grid.append(el('gridCol',w=w))
[?2004l[?2004h> table.append(grid)
[?2004l[?2004h> for rownum,p in enumerate(selected):
[?2004l[?2004h>  row=el('tr'); table.append(row)
[?2004l[?2004h>  if rownum==0:
[?2004l[?2004h>   rp=el('trPr'); rp.append(el('tblHeader')); row.append(rp)
[?2004l[?2004h>  paragraphs=[]
[?2004l[?2004h>  for width in widths:
[?2004l[?2004h>   cell=el('tc'); cp=el('tcPr'); cp.append(el('tcW',w=width,type='dxa')); cell.append(cp)
[?2004l[?2004h>   para=el('p')
[?2004l[?2004h>   if p.find('w:pPr',ns) is not None: para.append(deepcopy(p.find('w:pPr',ns)))
[?2004l[?2004h>   cell.append(para); row.append(cell); paragraphs.append(para)
[?2004l[?2004h>  col=0
[?2004l[?2004h>  for run in p.findall('w:r',ns):
[?2004l[?2004h>   text=''.join(run.xpath('./w:t/text()',namespaces=ns))
[?2004l[?2004h>   chunks=text.split(',')
[?2004l[?2004h>   for j,chunk in enumerate(chunks):
[?2004l[?2004h>    if j: col+=1
[?2004l[?2004h>    if not chunk: continue
[?2004l[?2004h>    newrun=deepcopy(run)
[?2004l[?2004h>    for child in list(newrun):
[?2004l[?2004h>     if child.tag!=tag('rPr'): newrun.remove(child)
[?2004l[?2004h>    t=el('t'); t.set('{http://www.w3.org/XML/1998/namespace}space','preserve'); t.text=chunk
[?2004l[?2004h>    newrun.append(t); paragraphs[col].append(newrun)
[?2004l[?2004h>  assert col==3
[?2004l[?2004h> body.insert(4,table)
[?2004l[?2004h> for p in selected: body.remove(p)
[?2004l[?2004h> actual=[[''.join(c.xpath('.//w:t/text()',namespaces=ns)) for c in r.findall('w:tc',ns)] for r in table.findall('w:tr',ns)]
[?2004l[?2004h> assert actual==expected
[?2004l[?2004h> assert [E.tostring(x) for x in body if x is not table]==[E.tostring(x) for i,x in enumerate(original) if not 4<=i<9]
[?2004l[?2004h> data['word/document.xml']=E.tostring(root,xml_declaration=True,encoding='UTF-8',standalone=True)
[?2004l[?2004h> tmp=path+'.tmp'
[?2004l[?2004h> with ZipFile(tmp,'w') as z:
[?2004l[?2004h>  for info in infos: z.writestr(info,data[info.filename])
[?2004l[?2004h> with ZipFile(tmp) as z:
[?2004l[?2004h>  assert z.testzip() is None
[?2004l[?2004h>  for info in infos:
[?2004l[?2004h>   assert z.read(info.filename)==data[info.filename]
[?2004l[?2004h> os.replace(tmp,path)
[?2004l[?2004h> from docx import Document
[?2004l[?2004h> doc=Document(path)
[?2004l[?2004h> assert any([[c.text for c in r.cells] for r in t.rows]==expected for t in doc.tables)
[?2004l[?2004h> print('Saved and verified:',path)
[?2004l[?2004h> print('New table: 5 rows x 4 columns; other document content preserved.')
[?2004l[?2004h> for row in actual: print(row)
[?2004l[?2004h> PY
[?2004l[?2004h[01;32magent@c88500295499[00m:[01;34m/app[00m$ python /tmp/convert_graphemes.py
[?2004lSaved and verified: /app/Graphemes_Sound_Letter_Patterns.docx
New table: 5 rows x 4 columns; other document content preserved.
['Sound-Letter Pattern', 'Grapheme', 'Example Grapheme', 'Example Word\xa0']
['1 letter making 1 sound', 'Graph', 'b\xa0\xa0\xa0 a', 'rub\xa0 cat\xa0']
['2 letters making 1 sound', 'Digraph\xa0\xa0\xa0\xa0\xa0\xa0', '\xa0ch\xa0\xa0\xa0 oy\xa0', 'chop\xa0 soy\xa0']
['3 letters making 1 sound\xa0\xa0', 'Trigraph\xa0', 'dge\xa0\xa0\xa0 ere\xa0', 'ridge\xa0\xa0\xa0 here\xa0']
['4 letters making 1 sound\xa0\xa0', 'Quadgraph\xa0\xa0\xa0\xa0\xa0', 'ough\xa0', 'through\xa0 though\xa0']
[?2004h[01;32magent@c88500295499[00m:[01;34m/app[00m$ 