[51.845036, "i", "PYTHONPATH=/tmp/report-libs python - <<'PY'\nimport mailbox,email.policy\nfrom email.parser import BytesParser\nfrom email.utils import parsedate_to_datetime,parseaddr\nfrom openpyxl import Workbook,load_workbook\nfrom openpyxl.styles import Font,PatternFill\nfrom openpyxl.utils import get_column_letter\np='/app/.thunderbird/t5q2a5hp.default-release/Mail/Local Folders/daily'\nmessages=list(mailbox.mbox(p,factory=lambda f: BytesParser(policy=email.policy.default).parse(f)))\nmessages=[m for m in messages if not (int(m.get('X-Mozilla-Status','0000'),16)&8)]\nmessages.sort(key=lambda m:parsedate_to_datetime(m['Date']).timestamp())\nw=Workbook(); s=w.active; s.title='daily'\ns.append(['sender_name','sender_address','subject','CC','number_of_attachments'])\nfor m in messages[-5:]:\n name,address=parseaddr(str(m['From']))\n cc=', '.join(str(h) for h in m.get_all('Cc',[]))\n attachments=sum(1 for part in m.walk() if part.get_content_disposition()=='attachment' or (part.get_filename() is not None and part.get_content_disposition()!="]
[51.8451, "i", "'inline'))\n s.append([name,address,str(m['Subject']),cc,attachments])\nfor c in s[1]:\n c.font=Font(bold=True,color='FFFFFF'); c.fill=PatternFill('solid',fgColor='305496')\nfor i,width in enumerate([34,37,43,36,25],1): s.column_dimensions[get_column_letter(i)].width=width\ns.freeze_panes='A2'; s.auto_filter.ref=s.dimensions\nw.save('/app/report.xlsx')\nr=load_workbook('/app/report.xlsx'); assert r.active.max_row==6 and r.active.max_column==5\nfor row in r.active.values: print(row)\nPY\nrm -rf /tmp/report-libs\nls -l /app/report.xlsx\n"]
