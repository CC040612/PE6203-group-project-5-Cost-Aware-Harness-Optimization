[?2004h[01;32magent@752b3f228563[00m:[01;34m/app[00m$ cat > /tmp/format_doc.py <<'PY'
[?2004l[?2004h> from zipfile import ZipFile
[?2004l[?2004h> from lxml import etree as E
[?2004l[?2004h> import re, os
[?2004l[?2004h> path='/app/04 CHIN9505 EBook Purchasing info 2021 Jan.docx'
[?2004l[?2004h> W='http://schemas.openxmlformats.org/wordprocessingml/2006/main'
[?2004l[?2004h> ns={'w':W}
[?2004l[?2004h> def tag(s): return '{'+W+'}'+s
[?2004l[?2004h> with ZipFile(path) as z:
[?2004l[?2004h>  infos=z.infolist(); data={i.filename:z.read(i.filename) for i in infos}
[?2004l[?2004h> root=E.fromstring(data['word/document.xml'])
[?2004l[?2004h> original=[]
[?2004l[?2004h> count=0
[?2004l[?2004h> for p in root.xpath('//w:p',namespaces=ns):
[?2004l[?2004h>  nodes=p.xpath('.//w:t',namespaces=ns)
[?2004l[?2004h>  text=''.join(n.text or '' for n in nodes)
[?2004l[?2004h>  original.append(text)
[?2004l[?2004h>  words=list(re.finditer(r'\S+',text))
[?2004l[?2004h>  if len(words)<=3: continue
[?2004l[?2004h>  start=words[2].end(); end=words[3].start()
[?2004l[?2004h>  offset=0; inserted=False
[?2004l[?2004h>  for n in nodes:
[?2004l[?2004h>   s=n.text or ''; a=offset; b=a+len(s); offset=b
[?2004l[?2004h>   if a<=start<b:
[?2004l[?2004h>    local=start-a
[?2004l[?2004h>    before=s[:local]; after=s[max(0,end-a):] if end<b else ''
[?2004l[?2004h>    n.text=before; n.set('{http://www.w3.org/XML/1998/namespace}space','preserve')
[?2004l[?2004h>    tab=E.Element(tag('tab')); n.addnext(tab)
[?2004l[?2004h>    if after:
[?2004l[?2004h>     t=E.Element(tag('t')); t.text=after; t.set('{http://www.w3.org/XML/1998/namespace}space','preserve'); tab.addnext(t)
[?2004l[?2004h>    inserted=True
[?2004l[?2004h>   elif a<end and b>start:
[?2004l[?2004h>    n.text=s[max(0,end-a):]
[?2004l[?2004h>  assert inserted
[?2004l[?2004h>  pr=p.find(tag('pPr'))
[?2004l[?2004h>  if pr is None: pr=E.Element(tag('pPr')); p.insert(0,pr)
[?2004l[?2004h>  for name in ('tabs','ind','jc'):
[?2004l[?2004h>   for old in pr.findall(tag(name)): pr.remove(old)
[?2004l[?2004h>  tabs=E.Element(tag('tabs')); E.SubElement(tabs,tag('tab'),{tag('val'):'left',tag('pos'):'5040'})
[?2004l[?2004h>  ind=E.Element(tag('ind'),{tag('left'):'5040',tag('hanging'):'5040'})
[?2004l[?2004h>  jc=E.Element(tag('jc'),{tag('val'):'left'})
[?2004l[?2004h>  idx=next((i for i,c in enumerate(pr) if c.tag==tag('rPr')),len(pr))
[?2004l[?2004h>  for c in (tabs,ind,jc): pr.insert(idx,c); idx+=1
[?2004l[?2004h>  count+=1
[?2004l[?2004h> newtexts=[''.join(p.xpath('.//w:t/text()',namespaces=ns)) for p in root.xpath('//w:p',namespaces=ns)]
[?2004l[?2004h> assert [[*re.findall(r'\S+',t)] for t in original]==[[*re.findall(r'\S+',t)] for t in newtexts]
[?2004l[?2004h> data['word/document.xml']=E.tostring(root,xml_declaration=True,encoding='UTF-8',standalone=True)
[?2004l[?2004h> tmp=path+'.tmp'
[?2004l[?2004h> with ZipFile(tmp,'w') as z:
[?2004l[?2004h>  for info in infos: z.writestr(info,data[info.filename])
[?2004l[?2004h> with ZipFile(tmp) as z: assert z.testzip() is None
[?2004l[?2004h> os.replace(tmp,path)
[?2004l[?2004h> print(f'Saved in place. Formatted {count} paragraphs; all words and other package parts preserved.')
[?2004l[?2004h> PY
