[54.605869, "i", "cat > /tmp/format_doc.py <<'PY'\nfrom zipfile import ZipFile\nfrom lxml import etree as E\nimport re, os\npath='/app/04 CHIN9505 EBook Purchasing info 2021 Jan.docx'\nW='http://schemas.openxmlformats.org/wordprocessingml/2006/main'\nns={'w':W}\ndef tag(s): return '{'+W+'}'+s\nwith ZipFile(path) as z:\n infos=z.infolist(); data={i.filename:z.read(i.filename) for i in infos}\nroot=E.fromstring(data['word/document.xml'])\noriginal=[]\ncount=0\nfor p in root.xpath('//w:p',namespaces=ns):\n nodes=p.xpath('.//w:t',namespaces=ns)\n text=''.join(n.text or '' for n in nodes)\n original.append(text)\n words=list(re.finditer(r'\\S+',text))\n if len(words)<=3: continue\n start=words[2].end(); end=words[3].start()\n offset=0; inserted=False\n for n in nodes:\n  s=n.text or ''; a=offset; b=a+len(s); offset=b\n  if a<=start<b:\n   local=start-a\n   before=s[:local]; after=s[max(0,end-a):] if end<b else ''\n   n.text=before; n.set('{http://www.w3.org/XML/1998/namespace}space','preserve')\n   tab=E.Element(tag('tab')); n.addnext(tab)\n   if after:\n    t=E.Element(tag('t')); t.text=after; t.set('{http://www.w3.org/XML/1998/namespace}space','preserve'); tab.addnext(t)\n   inserted=True\n  elif a<end and b>start:\n   n.text=s[max(0,end-a):]\n assert inserted\n pr=p.find(tag('pPr'))\n if pr is None: pr=E.Element(tag('pPr')); p.insert(0,pr)\n for name in ('tabs','ind','jc'):\n  for old in pr.findall(tag(name)): pr.remove(old)\n tabs=E.Element(tag('tabs')); E.SubElement(tabs,tag('tab'),{tag('val'):'left',tag('pos'):'5040'})\n ind=E.Element(tag('ind'),{tag('left'):'5040',tag('hanging'):'5040'})\n jc=E.Element(tag('jc'),{tag('val'):'left'})\n idx=next((i for i,c in enumerate(pr) if c.tag==tag('rPr')),len(pr))\n for c in (tabs,ind,jc): pr.insert(idx,c); idx+=1\n count+=1\nnewtexts=[''.join(p.xpath('.//w:t/text()',namespaces=ns)) for p in root.xpath('//w:p',namespaces=ns)]\nassert [[*re.findall(r'\\S+',t)] for t in original]==[[*re.findall(r'\\S+',t)] for t in newtexts]\ndata['word/document.xml']=E.tostring(root,xml_declaration=True,encoding='UTF-8',standalone=True)\ntmp=path+'.tmp'\nwith ZipFile(tmp,'w') as z:\n for info in infos: z.writestr(info,data[info.filename])\nwith ZipFile(tmp) as z: assert z.testzip() is None\nos.replace(tmp,path)\nprint(f'Saved in place. Formatted {count} paragraphs; all words and other package parts preserved.')\nPY\npython /tmp/format_doc.py\n"]
