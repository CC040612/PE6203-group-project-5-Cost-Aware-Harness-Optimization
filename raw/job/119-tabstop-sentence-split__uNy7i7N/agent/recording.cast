[66.673482, "o", "s=open(p).read().replace(\"newtexts=[''.join(p.xpath('.//w:t/text()',namespaces=ns)) for p in root.xpath('//w:p',namespaces=ns)]\", \"newtexts=[''.join(('\\\\t' if n.tag==tag('tab') else (n.text or '')) for n in p.iter() if n.tag in (tag('t'),tag('tab'))) for p in root.xpath('//w:p',namespaces=ns)]\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[66.694374, "o", "\u001b[?2004h\u001b[01;32magent@752b3f228563\u001b[00m:\u001b[01;34m/app\u001b[00m$ python /tmp/format_doc.py\r\n\u001b[?2004l\r"]
[66.751647, "o", "Saved in place. Formatted 10 paragraphs; all words and other package parts preserved.\r\n"]
[66.770214, "o", "\u001b[?2004h\u001b[01;32magent@752b3f228563\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
