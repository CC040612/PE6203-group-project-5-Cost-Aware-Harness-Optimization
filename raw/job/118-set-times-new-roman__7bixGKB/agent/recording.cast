[38.068638, "i", "python - <<'PY'\nfrom zipfile import ZipFile\nfrom lxml import etree as E\nimport os, copy\np='/app/Dublin_Zoo_Intro.docx'\nw='http://schemas.openxmlformats.org/wordprocessingml/2006/main'\nq=lambda s:'{'+w+'}'+s\nfont='Times New Roman'\ndef setfont(el):\n for a in ['asciiTheme','hAnsiTheme','eastAsiaTheme','cstheme','csTheme']:\n  el.attrib.pop(q(a),None)\n for a in ['ascii','hAnsi','eastAsia','cs']:\n  el.set(q(a),font)\ndef stripped(root):\n root=copy.deepcopy(root)\n for el in list(root.iter(q('rFonts'))):\n  el.getparent().remove(el)\n for el in list(root.iter(q('rPr'))):\n  if len(el)==0 and not el.attrib and not el.text:\n   el.getparent().remove(el)\n return E.tostring(root,method='c14n')\nwith ZipFile(p) as z:\n entries=z.infolist()\n original={i.filename:z.read(i.filename) for i in entries}\nupdated=dict(original)\nfor name,data in original.items():\n if not(name.startswith('word/') and name.endswith('.xml')): continue\n root=E.fromstring(data)\n before=stripped(root)\n for el in root.iter(q('rFonts')): setfont(el)\n for run in root.iter(q('r')):\n  props=run.find(q('rPr'))\n  if props is None:\n   props=E.Element(q('rPr')); run.insert(0,props)\n  fonts=props.find(q('rFonts'))\n  if fonts is None:\n   fonts=E.Element(q('rFonts')); props.insert(0,fonts)\n  setfont(fonts)\n if name=='word/styles.xml':\n  defaults=root.find(q('docDefaults'))\n  if defaults is not None:\n   rp=defaults.find(q('rPrDefault')+'/'+q('rPr'))\n   if rp is not None:\n    fonts=rp.find(q('rFonts'))\n    if fonts is None:\n     fonts=E.Element(q('rFonts')); rp.insert(0,fonts)\n    setfont(fonts)\n assert stripped(root)==before, 'Non-font change: '+name\n if E.tostring(root)!=E.tostring(E.fromstring(data)):\n  updated[name]=E.tostring(root,xml_declaration=True,encoding='UTF-8',standalone=True)\ntmp=p+'.tmp'\nwith ZipFile(tmp,'w') as z:\n for info in entries: z.writestr(info,updated[info.filename])\nwith ZipFile(tmp) as z:\n assert z.testzip() is None\n root=E.fromstring(z.read('word/document.xml'))\n for run in root.iter(q('r')):\n  fonts=run.find(q('rPr')+'/'+q('rFonts'))\n  assert all(fonts.get(q(a))==font for a in ['ascii','hAnsi','eastAsia','cs'])\nos.replace(tmp,p)\nprint('Saved:',p)\nprint('Modified font properties only in:',', '.join(n for n in original if original[n]!=updated[n]))\nPY\n"]
