[106.742761, "i", "/opt/venv/bin/python - <<'PY'\nfrom PIL import Image,ImageOps,ImageEnhance\nfor n,box in [(1,None),(3,None),(3,(0,450,800,933))]:\n im=Image.open(f'/home/agent/Pictures/picture{n}.jpg').convert('L')\n if box: im=im.crop(box)\n im=ImageOps.autocontrast(im).resize((90,32))\n print('\\nIMAGE',n,box)\n chars='@%#*+=-:. '\n for y in range(im.height):print(''.join(chars[v*9//256] for v in list(im.crop((0,y,90,y+1)).getdata())))\nPY\n"]
