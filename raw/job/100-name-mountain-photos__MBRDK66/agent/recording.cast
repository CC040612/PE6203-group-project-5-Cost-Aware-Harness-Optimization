[32.631148, "i", "python3 - <<'PY'\nfrom PIL import Image,ExifTags\nfrom pathlib import Path\nfor p in Path('/home/agent/Pictures').glob('*'):\n print('\\n',p.name)\n im=Image.open(p)\n for k,v in im.getexif().items(): print(ExifTags.TAGS.get(k,k),repr(v))\n print('info',im.info)\nPY\n"]
