[66.46632, "i", "python3 - <<'PY'\nimport subprocess\nfor n in [1,3]:\n p=subprocess.run(['ffmpeg','-v','error','-i',f'/home/agent/Pictures/picture{n}.jpg','-map','0:v:0','-vf','scale=100:38','-frames:v','1','-f','rawvideo','-pix_fmt','rgb24','-'],capture_output=True)\n print('PICTURE',n,'bytes',len(p.stdout),'error',p.stderr)\n if len(p.stdout)<11400: continue\n for y in range(38):\n  row=''\n  for x in range(100):\n   r,g,b=p.stdout[(y*100+x)*3:(y*100+x+1)*3]\n   row+=f'\\033[48;2;{r};{g};{b}m '\n  print(row+'\\033[0m')\nPY\n"]
[66.466605, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
