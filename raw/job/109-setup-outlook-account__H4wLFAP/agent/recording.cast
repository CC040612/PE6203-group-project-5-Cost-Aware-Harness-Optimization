[60.795291, "i", "/usr/bin/python3 - <<'PY'\nimport pyatspi,time\nfor attempt in range(10):\n found={}\n def walk(o):\n  try:\n   if o.getRoleName() in ('entry','password text') and o.name in ('Email address','Password'): found[o.name]=o\n   for c in o: walk(c)\n  except Exception: pass\n walk(pyatspi.Registry.getDesktop(0))\n if len(found)==2:\n  found['Email address'].queryEditableText().setTextContents('anonym-x2024@outlook.com')\n  found['Password'].queryEditableText().setTextContents('password')\n  found['Email address'].queryComponent().grabFocus()\n  print('Verified email:',found['Email address'].queryText().getText(0,-1))\n  print('Password characters:',found['Password'].queryText().characterCount)\n  break\n time.sleep(0.5)\nelse: print('Fields not found')\nPY\n"]
