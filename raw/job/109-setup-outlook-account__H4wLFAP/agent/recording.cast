[28.964121, "o", "\u001b[?2004h\u001b[01;32magent@4f49ca72fb28\u001b[00m:\u001b[01;34m/app\u001b[00m$ "]
[35.854705, "i", "sleep 2; /usr/bin/python3 - <<'PY'\nimport pyatspi\ndef walk(o,d=0):\n try:\n  r=o.getRoleName()\n  if r in ['entry','password text','push button','heading','document web','page tab','label']: print(r,repr(o.name))\n  for c in o: walk(c,d+1)\n except Exception: pass\nwalk(pyatspi.Registry.getDesktop(0))\nPY\n"]
