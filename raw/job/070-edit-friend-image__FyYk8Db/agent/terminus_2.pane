from PIL import Image
from rembg import remove, new_session
from pathlib import Path
p=Path('/home/user/Desktop')
im=Image.open(p/'ChMkKV8wsR6IBfEtABYfc0Tgu9cAAA1lQHO_78AFh-L733.jpg').convert('RGB')
s=new_session('u2net')
out=remove(im,session=s)
out.save(p/'pic.png')
white=Image.new('RGB',out.size,'white')
white.paste(out,mask=out.getchannel('A'))
white.save(p/'pic.jpg',quality=98,subsampling=0)
print('Saved:',out.size,'alpha extrema:',out.getchannel('A').getextrema(),'subject bounds:',out.getchannel('A').getbbox())
