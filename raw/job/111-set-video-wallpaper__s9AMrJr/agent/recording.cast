[68.786211, "i", "dbus-run-session -- /usr/bin/python3 - <<'PY'\nfrom gi.repository import Gio\nfrom pathlib import Path\np = Path.home()/'.local/share/backgrounds/interstellar.jpg'\nassert p.stat().st_size > 0\ns = Gio.Settings.new('org.gnome.desktop.background')\nfor k in ('picture-uri', 'picture-uri-dark'):\n    assert s.set_string(k, p.as_uri())\nassert s.set_string('picture-options', 'zoom')\nGio.Settings.sync()\nprint('Wallpaper preferences saved:', p)\nPY\ndbus-run-session -- /usr/bin/python3 - <<'PY'\nfrom gi.repository import Gio\ns = Gio.Settings.new('org.gnome.desktop.background')\nfor k in ('picture-uri','picture-uri-dark','picture-options'):\n    print(k, s.get_string(k))\nPY\n"]
