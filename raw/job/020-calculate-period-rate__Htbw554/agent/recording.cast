[26.547964, "i", "python - <<'PY'\nimport openpyxl\nfrom copy import copy\np='/app/PeriodRate.xlsx'\nw=openpyxl.load_workbook(p)\ns=w['Sheet1']\ns['C1']='Period Rate (%)'\ns['C1']._style=copy(s['A1']._style)\nfor r in range(2,s.max_row+1):\n c=s.cell(r,3,s.cell(r,1).value/s.cell(r,2).value)\n c._style=copy(s.cell(r,1)._style)\n c.number_format='0.0000'\nmaximum=max(s.cell(r,3).value for r in range(2,s.max_row+1))\nfor r in range(2,s.max_row+1):\n c=s.cell(r,3)\n if c.value==maximum:\n  f=copy(c.font)\n  f.color='FF00FF00'\n  c.font=f\ns.column_dimensions['C'].width=20\nw.save(p)\nw=openpyxl.load_workbook(p)\ns=w['Sheet1']\nassert s['C1'].value=='Period Rate (%)'\nassert all(s.cell(r,3).data_type=='n' for r in range(2,26))\nassert s['C20'].font.color.rgb=='FF00FF00'\nprint('Saved:',p,'; maximum:',s['C20'].value,'at C20')\nPY\n"]
[26.548495, "o", "python - <<'PY'\r\n"]
[26.548874, "o", "\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> from copy import copy\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/PeriodRate.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> w=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> s=w['Sheet1']\r\n\u001b[?2004l\r\u001b[?2004h> "]
