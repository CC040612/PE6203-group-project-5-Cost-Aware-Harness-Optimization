[56.897123, "o", "        title = page.locator('h1').first.inner_text() if page.locator('h1').count() else html.unescape(page.title()).split(' | ')[0]\r\n\u001b[?2004l\r"]
[56.897343, "o", "\u001b[?2004h>         print(title, page.url, flush=True)\r\n\u001b[?2004l\r"]
