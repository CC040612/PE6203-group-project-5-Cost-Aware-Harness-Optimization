[?2004l[?2004h>  [('Datta, P. (2020). Digital transformation of the Italian public administration: A case study. ',False),('Communications of the Association for Information Systems, 46',True),(', 252–272. https://doi.org/10.17705/1CAIS.04611',False)],
[?2004l[?2004h>  [('Dwivedi, Y. K., Shareef, M. A., Simintiras, A. C., Lal, B., & Weerakkody, V. (2016). A generalised adoption model for services: A cross-country comparison of mobile health (m-health). ',False),('Government Information Quarterly, 33',True),('(1), 174–187. https://doi.org/10.1016/j.giq.2015.06.003',False)],
[?2004l[?2004h>  [('European Commission. (2018). ',False),('Standard Eurobarometer 90: Public opinion in the European Union',True),('. https://ec.europa.eu/commfrontoffice/publicopinion/index.cfm/Survey/getSurveyDetail/instruments/STANDARD/surveyKy/2215',False)],
[?2004l[?2004h>  [('European Commission. (2019). ',False),('Digital Economy and Society Index (DESI) 2019: Country report Italy',True),('. https://ec.europa.eu/digital-single-market/en/news/digital-economy-and-society-index-desi-2019',False)],
[?2004l[?2004h>  [('Gartner. (2021). ',False),('Digital transformation',True),('. https://www.gartner.com/en/information-technology/glossary/digital-transformation',False)],
[?2004l[?2004h>  [('Mergel, I., Edelmann, N., & Haug, N. (2019). Defining digital transformation: Results from expert interviews. ',False),('Government Information Quarterly, 36',True),('(4), Article 101385. https://doi.org/10.1016/j.giq.2019.06.002',False)],
[?2004l[?2004h>  [('Organisation for Economic Co-operation and Development. (2017). ',False),('Digital government review of Norway: Boosting the digital transformation of the public sector',True),('. OECD Publishing. https://doi.org/10.1787/9789264279742-en',False)],
[?2004l[?2004h>  [('United Nations. (2018). ',False),('United Nations e-government survey 2018: Gearing e-government to support transformation towards sustainable and resilient societies',True),('. https://publicadministration.un.org/egovkb/Portals/egovkb/Documents/un/2018-Survey/EGovernment%20Survey%202018_FINAL%20for%20web.pdf',False)],
[?2004l[?2004h>  [('World Bank. (2016). ',False),('World development report 2016: Digital dividends',True),('. https://doi.org/10.1596/978-1-4648-0671-1',False)]
[?2004l[?2004h> ]
[?2004l[?2004h> for entry in entries:
[?2004l[?2004h>  p=d.add_paragraph(); p.alignment=WD_ALIGN_PARAGRAPH.LEFT
[?2004l[?2004h>  f=p.paragraph_format
[?2004l[?2004h>  f.left_indent=Inches(.5); f.first_line_indent=Inches(-.5)
[?2004l[?2004h>  f.right_indent=Inches(0); f.line_spacing=2
[?2004l[?2004h>  f.space_before=Pt(0); f.space_after=Pt(0)
[?2004l[?2004h>  f.widow_control=True
[?2004l[?2004h>  for text,italic in entry:
[?2004l[?2004h>   r=p.add_run(text);r.italic=italic;r.bold=False;r.font.name='Times New Roman';r.font.size=Pt(12)
[?2004l[?2004h> # Define the corporate-author abbreviation at its first citation.
[?2004l[?2004h> for p in d.paragraphs[:100]:
[?2004l[?2004h>  if '(OECD, 2017)' in p.text:
[?2004l[?2004h>   for r in p.runs:
[?2004l[?2004h>    if '(OECD, 2017)' in r.text:
[?2004l[?2004h>     r.text=r.text.replace('(OECD, 2017)','(Organisation for Economic Co-operation and Development [OECD], 2017)',1)
[?2004l[?2004h>     break
[?2004l[?2004h>   break
[?2004l[?2004h> d.save(path)
[?2004l[?2004h> check=Document(path)
[?2004l[?2004h> assert len(check.paragraphs)==110
[?2004l[?2004h> assert check.paragraphs[100].text=='References'
[?2004l[?2004h> assert check.paragraphs[100].paragraph_format.page_break_before
[?2004l[?2004h> for p in check.paragraphs[101:]:
[?2004l[?2004h>  assert p.paragraph_format.left_indent==Inches(.5)
[?2004l[?2004h>  assert p.paragraph_format.first_line_indent==Inches(-.5)
[?2004l[?2004h>  assert p.paragraph_format.line_spacing==2
[?2004l[?2004h> print('Saved and validated:',path)
[?2004l[?2004h> for p in check.paragraphs[100:]: print(p.text)
[?2004l[?2004h> PY
