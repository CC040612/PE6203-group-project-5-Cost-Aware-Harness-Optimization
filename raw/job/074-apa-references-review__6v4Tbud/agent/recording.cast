[129.989483, "o", " if '(OECD, 2017)' in p.text:\r\n\u001b[?2004l\r\u001b[?2004h>   for r in p.runs:\r\n\u001b[?2004l\r\u001b[?2004h>    if '(OECD, 2017)' in r.text:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.989555, "o", "    r.text=r.text.replace('(OECD, 2017)','(Organisation for Economic Co-operation and Development [OECD], 2017)',1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.990246, "o", "    break\r\n\u001b[?2004l\r\u001b[?2004h>   break\r\n\u001b[?2004l\r\u001b[?2004h> d.save(path)\r\n\u001b[?2004l\r\u001b[?2004h> check=Document(path)\r\n\u001b[?2004l\r\u001b[?2004h> assert len(check.paragraphs)==110\r\n\u001b[?2004l\r\u001b[?2004h> assert check.paragraphs[100].text=='References'\r\n\u001b[?2004l\r\u001b[?2004h> assert check.paragraphs[100].paragraph_format.page_break_before\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.990501, "o", "for p in check.paragraphs[101:]:\r\n\u001b[?2004l\r\u001b[?2004h>  assert p.paragraph_format.left_indent==Inches(.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.990623, "o", " assert p.paragraph_format.first_line_indent==Inches(-.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.99137, "o", " assert p.paragraph_format.line_spacing==2\r\n\u001b[?2004l\r\u001b[?2004h> print('Saved and validated:',path)\r\n\u001b[?2004l\r"]
[129.991891, "o", "\u001b[?2004h> for p in check.paragraphs[100:]: print(p.text)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
