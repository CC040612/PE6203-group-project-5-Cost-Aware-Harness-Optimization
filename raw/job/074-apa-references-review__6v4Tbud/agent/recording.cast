[129.988004, "o", " f.right_indent=Inches(0); f.line_spacing=2\r\n\u001b[?2004l\r\u001b[?2004h>  f.space_before=Pt(0); f.space_after=Pt(0)\r\n\u001b[?2004l\r\u001b[?2004h>  f.widow_control=True\r\n\u001b[?2004l\r"]
[129.988393, "o", "\u001b[?2004h>  for text,italic in entry:\r\n\u001b[?2004l\r\u001b[?2004h> "]
