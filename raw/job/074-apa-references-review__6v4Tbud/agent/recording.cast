[27.297851, "o", "116 '' STYLE Normal\r\n"]
[27.298007, "o", "117 'Dwivedi, Y. K., Shareef, M. A., Simintiras, A. C., Lal, B., & Weerakkody, V. (2017). A generalised adoption model for services: A cross-country comparison of mobile health (m-health). Government Information Quarterly, 30(1), 130-139.' STYLE Normal\r\n"]
[27.298151, "o", "118 '' STYLE Normal\r\n"]
[27.29832, "o", "119 'European Commission. (2018). Standard Eurobarometer 90: Public opinion in the European Union. October 1, 2022, https://ec.europa.eu/commfrontoffice/publicopinion/index.cfm/Survey/getSurveyDetail/instruments/STANDARD/surveyKy/2215' STYLE Normal\r\n"]
[27.298479, "o", "120 '' STYLE Normal\r\n"]
