[52.831204, "i", "c=\"chapter{i}.xhtml\"/></navPoint>' for i,(title,_) in enumerate(chapters,1))\nentries['OEBPS/toc.ncx'] = f'<?xml version=\"1.0\" encoding=\"utf-8\"?><ncx xmlns=\"http://www.daisy.org/z3986/2005/ncx/\" version=\"2005-1\"><head><meta name=\"dtb:uid\" content=\"{uid}\"/><meta name=\"dtb:depth\" content=\"1\"/><meta name=\"dtb:totalPageCount\" content=\"0\"/><meta name=\"dtb:maxPageNumber\" content=\"0\"/></head><docTitle><text>Pass Through</text></docTitle><navMap>{points}</navMap></ncx>'\nout = root / 'Pass Through.epub'\nwith zipfile.ZipFile(out, 'w', compression=zipfile.ZIP_DEFLATED) as z:\n    z.writestr('mimetype', 'application/epub+zip', compress_type=zipfile.ZIP_STORED)\n    for name, data in entries.items():\n        z.writestr(name, data.encode('utf-8'))\nwith zipfile.ZipFile(out) as z:\n    assert z.testzip() is None\n    assert z.infolist()[0].filename == 'mimetype'\n    assert z.infolist()[0].compress_type == zipfile.ZIP_STORED\n    for name in z.namelist():\n        if name.endswith(('.xml', '.opf', '.ncx', '.xhtml')):\n            ET."]
