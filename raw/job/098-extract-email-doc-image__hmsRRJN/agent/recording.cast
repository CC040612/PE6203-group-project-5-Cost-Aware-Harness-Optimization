[25.445236, "i", "python3 - <<'PY'\nimport zipfile,xml.etree.ElementTree as E,posixpath,io\nfrom PIL import Image\np='/tmp/doc-extract/lecture-notes.docx'\nwith zipfile.ZipFile(p) as z:\n ns={'a':'http://schemas.openxmlformats.org/drawingml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships'}\n root=E.fromstring(z.read('word/document.xml'))\n rels={e.attrib['Id']:e.attrib['Target'] for e in E.fromstring(z.read('word/_rels/document.xml.rels'))}\n images=[]\n for e in root.iter():\n  rid=e.get('{'+ns['r']+'}embed') or (e.get('{'+ns['r']+'}id') if e.tag.endswith('imagedata') else None)\n  if rid: images.append(rels[rid])\n print('Images in document order:',images)\n target=images[0]\n name=posixpath.normpath(posixpath.join('word',target)) if not target.startswith('/') else target.lstrip('/')\n data=z.read(name)\n im=Image.open(io.BytesIO(data));print('First image:',name,im.format,im.size)\n if im.format=='PNG': open('/app/background.png','wb').write(data)\n else: im.save('/app/background.png','PNG')\nPY\nfile /app/ba"]
