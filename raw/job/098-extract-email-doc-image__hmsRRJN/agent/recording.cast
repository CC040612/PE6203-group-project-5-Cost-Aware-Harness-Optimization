[34.196083, "i", "python3 - <<'PY'\nimport zipfile,xml.etree.ElementTree as E,posixpath\nwith zipfile.ZipFile('/tmp/doc-extract/lecture-notes.docx') as z:\n r='{http://schemas.openxmlformats.org/officeDocument/2006/relationships}'\n rels={e.attrib['Id']:e.attrib['Target'] for e in E.fromstring(z.read('word/_rels/document.xml.rels'))}\n for e in E.fromstring(z.read('word/document.xml')).iter():\n  rid=e.get(r+'embed') or (e.get(r+'id') if e.tag.endswith('imagedata') else None)\n  if rid:\n   target=rels[rid];name=posixpath.normpath(posixpath.join('word',target)) if not target.startswith('/') else target.lstrip('/')\n   print('First image:',name)\n   open('/tmp/doc-extract/first-image','wb').write(z.read(name));break\n else: raise RuntimeError('No image found')\nPY\nfile /tmp/doc-extract/first-image\nconvert /tmp/doc-extract/first-image /app/background.png\nfile /app/background.png; identify /app/background.png\n"]
