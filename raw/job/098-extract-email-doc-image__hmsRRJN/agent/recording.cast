[14.065251, "i", "mkdir -p /tmp/doc-extract; python3 - <<'PY'\nimport mailbox,email.utils,pathlib\np=next(pathlib.Path('/app/.thunderbird').glob('*/ImapMail/*/Notes'))\nmsgs=list(mailbox.mbox(str(p)))\nfor i,m in enumerate(msgs):\n print(i,m['Date'],m['Subject'],[(a.get_filename(),a.get_content_type()) for a in m.walk() if a.get_filename()])\nm=max(msgs,key=lambda m: email.utils.parsedate_to_datetime(m['Date']).timestamp())\nprint('NEWEST',m['Date'],m['Subject'])\nfor i,a in enumerate(m.walk()):\n if a.get_filename():\n  dest=pathlib.Path('/tmp/doc-extract')/pathlib.Path(a.get_filename()).name\n  dest.write_bytes(a.get_payload(decode=True));print(dest)\nPY\nfile /tmp/doc-extract/*\n"]
